$outbox_Click = {
	$logForm = New-Object System.Windows.Forms.Form
	$logForm.Text = "Execution Log"
	$logForm.Size = New-Object System.Drawing.Size(900, 600)
	
	$logBox = New-Object System.Windows.Forms.RichTextBox
	$logBox.Dock = "Fill"
	$logBox.ReadOnly = $true
	$logBox.Text = $outbox.Text
	
	$logBox.SelectionStart = $logBox.TextLength
	$logBox.ScrollToCaret()
	
	$logForm.Controls.Add($logBox)
	$logForm.Show()
	
	$VisibleLines = [Math]::Floor($logBox.ClientSize.Height / $logBox.Font.Height)
	$LastLine = $logBox.GetLineFromCharIndex($logBox.TextLength)
	$TargetLine = [Math]::Max(0, $LastLine - $VisibleLines + 2)
	
	$logBox.Select($logBox.GetFirstCharIndexFromLine($TargetLine), 0)
	$logBox.ScrollToCaret()
}

