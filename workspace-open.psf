  <Object type="SAPIENTypes.FolderBrowserModernDialog, PowerShell Studio, Version=5.5.148.0, Culture=neutral, PublicKeyToken=null" name="folderbrowsermoderndialog1">
    <Property name="InitialDirectory">\\sccm\source\etc\installs</Property>
  </Object>
  <Object type="System.Windows.Forms.OpenFileDialog, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" name="openfiledialog1">
    <Property name="DefaultExt">txt</Property>
    <Property name="Filter">All Files|*.*</Property>
    <Property name="InitialDirectory">\\sccm\source\etc\installs</Property>
    <Property name="ShowHelp">True</Property>
    <Event name="FileOk">openfiledialog1_FileOk</Event>
  </Object>
  <Object type="System.Windows.Forms.OpenFileDialog, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" name="openfiledialog2">
    <Property name="DefaultExt">txt</Property>
    <Property name="Filter">All Files|*.*</Property>
    <Property name="ShowHelp">True</Property>
  </Object>
  <Code><![CDATA[
$formGoogleWorkspaceTools_Load = {
	
	$global:domain = (Get-CimInstance Win32_ComputerSystem).Domain
	$BasePath = [System.AppDomain]::CurrentDomain.BaseDirectory
	$ConfigPath = Join-Path $BasePath "workspace.xml"
	
	if (Test-Path $ConfigPath)
	{
		
		[xml]$Config = Get-Content $ConfigPath -Raw
		
		$global:Domain = $Config.Settings.Domain
		$global:clientid = $Config.Settings.ClientID
		$global:secret = $Config.Settings.secret
		
		#Write-Host "Variables loaded from config file "
		#Write-Host $domain $homeserver $syncserver $exportpath
		$outbox.AppendText("`r`nVariables loaded.")
	}
	else{ $outbox.AppendText("`r`nXML File not found, missing Domain, ClientID, and Secret.")}
	Write-Host "Domain:"
	Write-Host $domain
		

		$global:defaulttext = $richtextbox1.Text
		
		$textbox1.SelectAll()
		$textbox1.Select()
	
}


$ErrorActionPreference = 'Continue'
$global:bat = "false"
$global:MSI = "false"
$global:PS1 = "false"
$global:setupcmd = $null
$global:filepath = $null
$global:Cname = $null
$global:Pname = $null
$global:options = $null
$global:outbox = $null
$global:joblist = $null
$global:cmd2 = $null
$global:fullpath = $null
$global:prof = $null
$global:notes = $null
$global:Cmodel = $null
$global:address = $null
$global:AccessToken = $null
$global:RefreshToken = $null
$global:Devices = $null
$global:OAuthEmail = $null

$Scope = @(
	'https://www.googleapis.com/auth/admin.directory.device.chromeos'
	'https://www.googleapis.com/auth/chrome.management.telemetry.readonly'
	'https://www.googleapis.com/auth/chrome.management.reports.readonly'
	'https://www.googleapis.com/auth/admin.directory.orgunit.readonly'
	'https://www.googleapis.com/auth/userinfo.email'
	'https://www.googleapis.com/auth/admin.directory.user'
	'https://www.googleapis.com/auth/admin.directory.user.security'
) -join ' '

#$global:module = get-module -ListAvailable -Name activedirectory



$buttonBrowse_Click = {
	
	if ($openfiledialog1.ShowDialog() -eq 'OK')
	{
		$textboxFile.Text = $openfiledialog1.FileName
	}
}

$buttonCancel_Click = {
	$script:CancelLoop = $true
}

$buttonLookupSerialUserInDr_Click = {
	# ================================
	# Search Selected Chromebook/User
	# ================================
	
	$Headers = @{
		Authorization  = "Bearer $global:AccessToken"
	}
	
	$SelectedItem = [string]$combobox1.SelectedItem
	
	if ([string]::IsNullOrWhiteSpace($SelectedItem))
	{
		$outbox.AppendText("`r`nNothing is selected.")
		return
	}
	
	# --------------------------------
	# 1. Selected item is a user
	# --------------------------------
	
	if ($SelectedItem -match '@')
	{
		$Query = "recent_user:$SelectedItem"
		
		$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
		'?projection=FULL' +
		'&maxResults=21' +
		'&query=' + [Uri]::EscapeDataString($Query)
		
		try
		{
			$Response = Invoke-RestMethod `
										  -Uri $Uri `
										  -Method Get `
										  -Headers $Headers `
										  -ErrorAction Stop
			
			if ($Response.PSObject.Properties['chromeosdevices'])
			{
				$global:Devices = @($Response.chromeosdevices)
			}
			else
			{
				$global:Devices = @()
			}
		}
		catch
		{
			$global:Devices = @()
			
			$outbox.AppendText("`r`nRecent-user search failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		if ($global:Devices.Count -eq 0)
		{
			$outbox.AppendText("`r`nNo matching devices found.")
			return
		}
		
		# If exactly one device was found,
		# make it the current global device
		if ($global:Devices.Count -eq 1)
		{
			$global:Device = $global:Devices[0]
		}
		else
		{
			$global:Device = $null
		}
		
		# --------------------------------
		# Display results
		# --------------------------------
		
		$outbox.AppendText("`r`nDEVICE RESULTS")
		$outbox.AppendText("`r`n==============")
		
		foreach ($Device in @($global:Devices))
		{
			$Model = $Device.model -replace '\s*\(.*\)$', ''
			
			$outbox.AppendText("`r`n")
			$outbox.AppendText("`r`nSerial:     $($Device.serialNumber)")
			$outbox.AppendText("`r`nModel:      $Model")
			$outbox.AppendText("`r`nOS Version: $($Device.osVersion)")
			$outbox.AppendText("`r`nLast Sync:  $($Device.lastSync)")
			$outbox.AppendText("`r`nUser:       $($Device.annotatedUser)")
			
			$IPAddresses = @(
				foreach ($Network in @($Device.lastKnownNetwork))
				{
					if ($Network.ipAddress)
					{
						$Network.ipAddress
					}
				}
			)
			
			if ($IPAddresses.Count -gt 0)
			{
				$outbox.AppendText("`r`nIP:")
				
				foreach ($IP in $IPAddresses)
				{
					$outbox.AppendText("`r`n  $IP")
				}
			}
			else
			{
				$outbox.AppendText("`r`nIP: Unknown")
			}
			
			$outbox.AppendText("`r`nRecent Users:")
			
			$RecentUsers = @(
				foreach ($RecentUser in @($Device.recentUsers))
				{
					if ($RecentUser.email)
					{
						$RecentUser.email
					}
				}
			)
			
			if ($RecentUsers.Count -gt 0)
			{
				foreach ($RecentUser in $RecentUsers)
				{
					$outbox.AppendText("`r`n  $RecentUser")
				}
			}
			else
			{
				$outbox.AppendText("`r`n  None")
			}
			
			$outbox.AppendText("`r`n------------------------------")
		}
		
		return
	}
	
	# --------------------------------
	# 2. Selected item is a device
	# --------------------------------
	
	$Query = "id:$SelectedItem"
	
	$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
	'?projection=FULL' +
	'&maxResults=1' +
	'&query=' + [Uri]::EscapeDataString($Query)
	
	try
	{
		$Response = Invoke-RestMethod `
									  -Uri $Uri `
									  -Method Get `
									  -Headers $Headers `
									  -ErrorAction Stop
		
		if ($Response.PSObject.Properties['chromeosdevices'] -and
			@($Response.chromeosdevices).Count -gt 0)
		{
			$global:Device = @($Response.chromeosdevices)[0]
		}
		else
		{
			$global:Device = $null
		}
	}
	catch
	{
		$global:Device = $null
		
		$outbox.AppendText("`r`nDevice search failed.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	if (-not $global:Device)
	{
		$outbox.AppendText("`r`nNo matching device found.")
		return
	}
	
	# Keep Devices available to other functions
	$global:Devices = @($global:Device)
	
	# --------------------------------
	# Display selected device
	# --------------------------------
	
	$Device = $global:Device
	$Model = $Device.model -replace '\s*\(.*\)$', ''
	
	$outbox.AppendText("`r`nDEVICE RESULTS")
	$outbox.AppendText("`r`n==============")
	$outbox.AppendText("`r`n")
	$outbox.AppendText("`r`nSerial:     $($Device.serialNumber)")
	$outbox.AppendText("`r`nModel:      $Model")
	$outbox.AppendText("`r`nOS Version: $($Device.osVersion)")
	$outbox.AppendText("`r`nLast Sync:  $($Device.lastSync)")
	$outbox.AppendText("`r`nUser:       $($Device.annotatedUser)")
	
	$IPAddresses = @(
		foreach ($Network in @($Device.lastKnownNetwork))
		{
			if ($Network.ipAddress)
			{
				$Network.ipAddress
			}
		}
	)
	
	if ($IPAddresses.Count -gt 0)
	{
		$outbox.AppendText("`r`nIP:")
		
		foreach ($IP in $IPAddresses)
		{
			$outbox.AppendText("`r`n  $IP")
		}
	}
	else
	{
		$outbox.AppendText("`r`nIP: Unknown")
	}
	
	$outbox.AppendText("`r`nRecent Users:")
	
	$RecentUsers = @(
		foreach ($RecentUser in @($Device.recentUsers))
		{
			if ($RecentUser.email)
			{
				$RecentUser.email
			}
		}
	)
	
	if ($RecentUsers.Count -gt 0)
	{
		foreach ($RecentUser in $RecentUsers)
		{
			$outbox.AppendText("`r`n  $RecentUser")
		}
	}
	else
	{
		$outbox.AppendText("`r`n  None")
	}
	
	$outbox.AppendText("`r`n------------------------------")
}
#region Control Helper Functions
function Update-ComboBox
{
<#
	.SYNOPSIS
		This functions helps you load items into a ComboBox.
	
	.DESCRIPTION
		Use this function to dynamically load items into the ComboBox control.
	
	.PARAMETER ComboBox
		The ComboBox control you want to add items to.
	
	.PARAMETER Items
		The object or objects you wish to load into the ComboBox's Items collection.
	
	.PARAMETER DisplayMember
		Indicates the property to display for the items in this control.
	
	.PARAMETER Append
		Adds the item(s) to the ComboBox without clearing the Items collection.
	
	.EXAMPLE
		Update-ComboBox $combobox1 "Red", "White", "Blue"
	
	.EXAMPLE
		Update-ComboBox $combobox1 "Red" -Append
		Update-ComboBox $combobox1 "White" -Append
		Update-ComboBox $combobox1 "Blue" -Append
	
	.EXAMPLE
		Update-ComboBox $combobox1 (Get-Process) "ProcessName"
	
	.NOTES
		Additional information about the function.
#>
	
	param
	(
		[Parameter(Mandatory = $true)]
		[ValidateNotNull()]
		[System.Windows.Forms.ComboBox]$ComboBox,
		[Parameter(Mandatory = $true)]
		[ValidateNotNull()]
		$Items,
		[Parameter(Mandatory = $false)]
		[string]$DisplayMember,
		[switch]$Append
	)
	
	if (-not $Append)
	{
		$ComboBox.Items.Clear()
	}
	
	if ($Items -is [Object[]])
	{
		$ComboBox.Items.AddRange($Items)
	}
	elseif ($Items -is [System.Collections.IEnumerable])
	{
		$ComboBox.BeginUpdate()
		foreach ($obj in $Items)
		{
			$ComboBox.Items.Add($obj)
		}
		$ComboBox.EndUpdate()
	}
	else
	{
		$ComboBox.Items.Add($Items)
	}
	
	$ComboBox.DisplayMember = $DisplayMember
}
#endregion

