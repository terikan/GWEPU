$buttonLock_Click = {
	# ================================
	# Chromebook Lock / User Enable
	# ================================
	
	if (-not $global:AccessToken)
	{
		return
	}
	
	$SelectedItem = [string]$combobox1.SelectedItem
	
	if ([string]::IsNullOrWhiteSpace($SelectedItem))
	{
		$outbox.AppendText("`r`nNothing is selected.")
		return
	}
	
	$Headers = @{
		Authorization  = "Bearer $global:AccessToken"
	}
	
	# ========================================
	# USER
	# ========================================
	
	if ($SelectedItem -match '@')
	{
		$UserEmail = $SelectedItem
		
		$UserUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
		[Uri]::EscapeDataString($UserEmail)
		
		try
		{
			$User = Invoke-RestMethod `
									  -Uri $UserUri `
									  -Method Get `
									  -Headers $Headers `
									  -ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nUnable to get current user status.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		# --------------------------------
		# Get current user status
		# --------------------------------
		
		$IsSuspended = [bool]$User.suspended
		
		# --------------------------------
		# Create action menu
		# --------------------------------
		
		$ActionForm = New-Object System.Windows.Forms.Form
		$ActionForm.Text = "User Action"
		$ActionForm.Size = New-Object System.Drawing.Size(335, 150)
		$ActionForm.StartPosition = "CenterScreen"
		$ActionForm.FormBorderStyle = "FixedDialog"
		$ActionForm.MaximizeBox = $false
		$ActionForm.MinimizeBox = $false
		
		$StatusButton = New-Object System.Windows.Forms.Button
		$StatusButton.Location = New-Object System.Drawing.Point(15, 20)
		$StatusButton.Size = New-Object System.Drawing.Size(135, 30)
		
		$CancelButton = New-Object System.Windows.Forms.Button
		$CancelButton.Location = New-Object System.Drawing.Point(165, 20)
		$CancelButton.Size = New-Object System.Drawing.Size(135, 30)
		$CancelButton.Text = "Cancel"
		
		if ($IsSuspended)
		{
			$StatusButton.Text = "Enable"
		}
		else
		{
			$StatusButton.Text = "Disable"
		}
		
		$StatusButton.Add_Click({
				$ActionForm.Tag = $StatusButton.Text
				$ActionForm.Close()
			})
		
		$CancelButton.Add_Click({
				$ActionForm.Tag = "Cancel"
				$ActionForm.Close()
			})
		
		$ActionForm.Controls.Add($StatusButton)
		$ActionForm.Controls.Add($CancelButton)
		
		[void]$ActionForm.ShowDialog()
		
		$Action = $ActionForm.Tag
		$ActionForm.Dispose()
		
		# --------------------------------
		# Cancel
		# --------------------------------
		
		if ($Action -eq "Cancel" -or -not $Action)
		{
			return
		}
		
		# --------------------------------
		# Enable / Disable user
		# --------------------------------
		
		if ($Action -eq "Disable")
		{
			$Suspended = $true
		}
		elseif ($Action -eq "Enable")
		{
			$Suspended = $false
		}
		else
		{
			return
		}
		
		$Body = @{
			suspended  = $Suspended
		} | ConvertTo-Json -Compress
		
		try
		{
			$Result = Invoke-RestMethod `
										-Uri $UserUri `
										-Method Put `
										-Headers @{
				Authorization   = "Bearer $global:AccessToken"
				'Content-Type'  = 'application/json'
			} `
										-Body $Body `
										-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`n$Action failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nUser $($Action.ToLower()) command completed.")
		
		# Keep global user information current
		$User.suspended = $Suspended
		$global:User = $User
		
		return
	}
	
	
	# ========================================
	# CHROMEBOOK
	# ========================================
	
	$Device = $global:Devices |
	Where-Object { $_.serialNumber -eq $global:Cname } |
	Select-Object -First 1
	
	if (-not $Device)
	{
		$Device = $global:Devices |
		Where-Object { $_.serialNumber -eq $SelectedItem } |
		Select-Object -First 1
	}
	
	if (-not $Device)
	{
		$outbox.AppendText("`r`nDevice not found.")
		return
	}
	
	# --------------------------------
	# Get current device status
	# --------------------------------
	
	$DeviceUri = "https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos/$($Device.deviceId)?projection=FULL"
	
	try
	{
		$CurrentDevice = Invoke-RestMethod `
										   -Uri $DeviceUri `
										   -Method Get `
										   -Headers $Headers `
										   -ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`nUnable to get current device status.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	$Status = $CurrentDevice.status
	
	# --------------------------------
	# Create action menu
	# --------------------------------
	
	$ActionForm = New-Object System.Windows.Forms.Form
	$ActionForm.Text = "Device Action"
	$ActionForm.Size = New-Object System.Drawing.Size(320, 150)
	$ActionForm.StartPosition = "CenterScreen"
	$ActionForm.FormBorderStyle = "FixedDialog"
	$ActionForm.MaximizeBox = $false
	$ActionForm.MinimizeBox = $false
	
	$LockButton = New-Object System.Windows.Forms.Button
	$LockButton.Location = New-Object System.Drawing.Point(15, 20)
	$LockButton.Size = New-Object System.Drawing.Size(85, 30)
	
	$RestartButton = New-Object System.Windows.Forms.Button
	$RestartButton.Location = New-Object System.Drawing.Point(110, 20)
	$RestartButton.Size = New-Object System.Drawing.Size(85, 30)
	$RestartButton.Text = "Restart"
	
	$CancelButton = New-Object System.Windows.Forms.Button
	$CancelButton.Location = New-Object System.Drawing.Point(205, 20)
	$CancelButton.Size = New-Object System.Drawing.Size(85, 30)
	$CancelButton.Text = "Cancel"
	
	if ($Status -eq "DISABLED")
	{
		$LockButton.Text = "Unlock"
	}
	else
	{
		$LockButton.Text = "Lock"
	}
	
	$LockButton.Add_Click({
			$ActionForm.Tag = $LockButton.Text
			$ActionForm.Close()
		})
	
	$RestartButton.Add_Click({
			$ActionForm.Tag = "Restart"
			$ActionForm.Close()
		})
	
	$CancelButton.Add_Click({
			$ActionForm.Tag = "Cancel"
			$ActionForm.Close()
		})
	
	$ActionForm.Controls.Add($LockButton)
	$ActionForm.Controls.Add($RestartButton)
	$ActionForm.Controls.Add($CancelButton)
	
	[void]$ActionForm.ShowDialog()
	
	$Action = $ActionForm.Tag
	$ActionForm.Dispose()
	
	# --------------------------------
	# Cancel
	# --------------------------------
	
	if ($Action -eq "Cancel" -or -not $Action)
	{
		return
	}
	
	# --------------------------------
	# Lock / Unlock
	# --------------------------------
	
	if ($Action -eq "Lock" -or $Action -eq "Unlock")
	{
		if ($Action -eq "Lock")
		{
			$StatusAction = "CHANGE_CHROME_OS_DEVICE_STATUS_ACTION_DISABLE"
		}
		else
		{
			$StatusAction = "CHANGE_CHROME_OS_DEVICE_STATUS_ACTION_REENABLE"
		}
		
		$Body = @{
			deviceIds  = @($Device.deviceId)
			changeChromeOsDeviceStatusAction = $StatusAction
		} | ConvertTo-Json -Compress
		
		$Uri = "https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos:batchChangeStatus"
		
		try
		{
			$Result = Invoke-RestMethod `
										-Uri $Uri `
										-Method Post `
										-Headers $Headers `
										-ContentType "application/json" `
										-Body $Body `
										-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`n$Action failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nDevice $($Action.ToLower()) command completed.")
		
		# Keep the global device information current
		$Device.status = if ($Action -eq "Lock") { "DISABLED" }
		else { "ACTIVE" }
		
		return
	}
	
	# --------------------------------
	# Restart
	# --------------------------------
	
	if ($Action -eq "Restart")
	{
		$Body = @{
			commandType  = "REBOOT"
		} | ConvertTo-Json -Compress
		
		$Uri = "https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos/$($Device.deviceId):issueCommand"
		
		try
		{
			$Result = Invoke-RestMethod `
										-Uri $Uri `
										-Method Post `
										-Headers $Headers `
										-ContentType "application/json" `
										-Body $Body `
										-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nRestart failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nRestart command issued.")
		$outbox.AppendText("`r`nCommand ID: $($Result.commandId)")
	}
}

$textbox1_KeyDown = [System.Windows.Forms.KeyEventHandler]{
		if ($_.KeyCode -eq "Enter")
	{
		$_.SuppressKeyPress = $true
		$_.Handled = $true
		$ExploreFiles_Click.Invoke()
		}
	

