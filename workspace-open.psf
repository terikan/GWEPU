$buttonAddPrinter_Click = {
	# ================================
	# Move User / Chromebook to OU
	# ================================
	
	if (-not $global:AccessToken)
	{
		return
	}
	
	$SelectedItem = [string]$combobox1.SelectedItem
	
	if ([string]::IsNullOrWhiteSpace($SelectedItem))
	{
		$outbox.AppendText("`r`nNothing is selected.")
		return
	}
	
	$Headers = @{
		Authorization  = "Bearer $global:AccessToken"
	}
	
	# =================================
	# Determine whether selection is User
	# =================================
	
	$IsUser = $SelectedItem -match '@'
	
	# --------------------------------
	# Find selected object
	# --------------------------------
	
	if ($IsUser)
	{
		# ================================
		# Find User
		# ================================
		
		$UserUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
		[Uri]::EscapeDataString($SelectedItem)
		
		try
		{
			$User = Invoke-RestMethod `
									  -Uri $UserUri `
									  -Method Get `
									  -Headers $Headers `
									  -ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nUser not found.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nCurrent OU: $($User.orgUnitPath)")
	}
	else
	{
		# ================================
		# Find Device
		# ================================
		
		$Device = $global:Devices |
		Where-Object { $_.serialNumber -eq $global:Cname } |
		Select-Object -First 1
		
		if (-not $Device)
		{
			$Device = $global:Devices |
			Where-Object { $_.serialNumber -eq $SelectedItem } |
			Select-Object -First 1
		}
		
		if (-not $Device)
		{
			$outbox.AppendText("`r`nDevice not found.")
			return
		}
		
		$outbox.AppendText("`r`nCurrent OU: $($Device.orgUnitPath)")
	}
	
	# --------------------------------
	# Get organization tree
	# --------------------------------
	
	$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/orgunits' +
	'?orgUnitPath=%2F&type=all_including_parent'
	
	try
	{
		$Response = Invoke-RestMethod `
									  -Uri $Uri `
									  -Method Get `
									  -Headers $Headers `
									  -ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`nFailed to retrieve organizational units.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	$OrgUnits = @($Response.organizationUnits)
	
	if ($OrgUnits.Count -eq 0)
	{
		$outbox.AppendText("`r`nNo organizational units were returned.")
		return
	}
	
	# --------------------------------
	# Create OU selection form
	# --------------------------------
	
	if ($IsUser)
	{
		$FormTitle = "Move $($User.primaryEmail)"
	}
	else
	{
		$FormTitle = "Move $($Device.serialNumber)"
	}
	
	$Form = New-Object System.Windows.Forms.Form
	$Form.Text = $FormTitle
	$Form.Size = New-Object System.Drawing.Size(660, 750)
	$Form.StartPosition = "CenterScreen"
	
	$Tree = New-Object System.Windows.Forms.TreeView
	$Tree.Font = New-Object System.Drawing.Font("Segoe UI", 14)
	$Tree.Location = New-Object System.Drawing.Point(10, 10)
	$Tree.Size = New-Object System.Drawing.Size(620, 620)
	$Tree.HideSelection = $false
	
	$OkButton = New-Object System.Windows.Forms.Button
	$OkButton.Location = New-Object System.Drawing.Point(455, 640)
	$OkButton.Size = New-Object System.Drawing.Size(80, 35)
	$OkButton.Text = "OK"
	
	$CancelButton = New-Object System.Windows.Forms.Button
	$CancelButton.Location = New-Object System.Drawing.Point(540, 640)
	$CancelButton.Size = New-Object System.Drawing.Size(80, 35)
	$CancelButton.Text = "Cancel"
	
	# --------------------------------
	# Build tree
	# --------------------------------
	
	$Nodes = @{ }
	
	foreach ($OU in $OrgUnits)
	{
		$Node = New-Object System.Windows.Forms.TreeNode
		$Node.Text = $OU.name
		$Node.Tag = $OU.orgUnitPath
		$Nodes[$OU.orgUnitPath] = $Node
	}
	
	foreach ($OU in $OrgUnits)
	{
		$Node = $Nodes[$OU.orgUnitPath]
		
		if ($OU.parentOrgUnitPath -and $Nodes.ContainsKey($OU.parentOrgUnitPath))
		{
			[void]$Nodes[$OU.parentOrgUnitPath].Nodes.Add($Node)
		}
		else
		{
			[void]$Tree.Nodes.Add($Node)
		}
	}
	
	$OkButton.Add_Click({
			if ($Tree.SelectedNode)
			{
				$Form.Tag = $Tree.SelectedNode.Tag
				$Form.Close()
			}
		})
	
	$CancelButton.Add_Click({
			$Form.Tag = $null
			$Form.Close()
		})
	
	$Form.Controls.Add($Tree)
	$Form.Controls.Add($OkButton)
	$Form.Controls.Add($CancelButton)
	
	[void]$Form.ShowDialog()
	
	$SelectedOU = $Form.Tag
	
	$Form.Dispose()
	
	if (-not $SelectedOU)
	{
		return
	}
	
	# --------------------------------
	# Move selected object
	# --------------------------------
	
	if ($IsUser)
	{
		# ================================
		# Move User
		# ================================
		
		$MoveUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
		[Uri]::EscapeDataString($User.primaryEmail)
		
		$MoveBody = @{
			orgUnitPath  = $SelectedOU
		} | ConvertTo-Json -Compress
		
		try
		{
			$MoveResult = Invoke-RestMethod `
											-Uri $MoveUri `
											-Method Put `
											-Headers $Headers `
											-ContentType 'application/json' `
											-Body $MoveBody `
											-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nFailed to move user.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nUser moved successfully.")
		$outbox.AppendText("`r`nUser: $($User.primaryEmail)")
		$outbox.AppendText("`r`nNew OU: $SelectedOU")
		
		# Update the local object
		$User.orgUnitPath = $SelectedOU
		
		# Keep global user current if it exists
		$global:User = $User
	}
	else
	{
		# ================================
		# Move Device
		# ================================
		
		$MoveBody = @{
			deviceIds  = @($Device.deviceId)
		} | ConvertTo-Json -Compress
		
		$MoveUri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos/moveDevicesToOu' +
		'?orgUnitPath=' + [Uri]::EscapeDataString($SelectedOU)
		
		try
		{
			$MoveResult = Invoke-RestMethod `
											-Uri $MoveUri `
											-Method Post `
											-Headers $Headers `
											-ContentType 'application/json' `
											-Body $MoveBody `
											-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nFailed to move device.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		$outbox.AppendText("`r`nDevice moved successfully.")
		$outbox.AppendText("`r`nDevice: $($Device.serialNumber)")
		$outbox.AppendText("`r`nNew OU: $SelectedOU")
		
		# Update the local object
		$Device.orgUnitPath = $SelectedOU
		
		# Keep global device current
		$global:Device = $Device
	}
}



