$combobox1_SelectedIndexChanged = {
	$buttonLookupSerialUserInDr.Enabled = $true
	$buttonLookupSerialUserInDr.BackColor = 'gradientactivecaption'
	
	# --------------------------------
	# Update selected Chromebook device
	# --------------------------------
	
	$SelectedItem = [string]$combobox1.SelectedItem
	
	if ($SelectedItem -and $SelectedItem -notmatch '@')
	{
		if (-not $global:Device -or $global:Device.serialNumber -ne $SelectedItem)
		{
			$Query = "id:$SelectedItem"
			
			$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
			'?projection=FULL' +
			'&maxResults=1' +
			'&query=' + [Uri]::EscapeDataString($Query)
			
			try
			{
				$Response = Invoke-RestMethod `
											  -Uri $Uri `
											  -Method Get `
											  -Headers @{
					Authorization  = "Bearer $global:AccessToken"
				} `
											  -ErrorAction Stop
				
				if ($Response.PSObject.Properties['chromeosdevices'] -and
					@($Response.chromeosdevices).Count -gt 0)
				{
					$global:Device = @($Response.chromeosdevices)[0]
				}
				else
				{
					$global:Device = $null
				}
			}
			catch
			{
				$global:Device = $null
			}
		}
	}
	
	#$progressbar1.Value = 0
	#TODO: Place custom script here
	$premade = $global:joblist | where-object Name -eq $combobox1.SelectedItem
	#Write-Host $global:joblist | where-object Name -eq $combobox1.SelectedValue
	#Write-Host $combobox1.SelectedItem
	$global:setupcmd = $premade.Command
	#$outbox.AppendText("$global:setupcmd")
	$global:cmd2 = $premade.cmd2
	#$textbox3.Text = $premade.Path + "\" + $premade.Command
	#$textbox4.Text = ""
	$global:filepath = $premade.Path
	#$buttonBrowseFolder.Text = $premade.Path
	$global:bat = "false"
	$global:MSI = "false"
	$global:PS1 = "false"
	if ($global:setupcmd -like '*.bat')
	{
		$global:bat = "true"
		#$outbox.AppendText("Batch File Selected")
	}
	if ($global:setupcmd -like '*.ps1')
	{
		$global:PS1 = "true"
		#$outbox.AppendText("Powershell Selected")
	}
	if ($global:setupcmd -like '*.msi')
	{
		$global:MSI = "true"
		#$outbox.AppendText("MSI Installer Selected")
	}
	
	$global:notes = $premade.notes

	if ($global:notes)
	{
		$outbox.AppendText("`r`n" + $global:notes)
	}
}

$buttonRemote_Click = {
	#TODO: Place custom script here
	$quserResult = quser /server:$global:Cname 2>&1
	If ($quserResult.Count -gt 0)
	{
		$quserRegex = $quserResult | ForEach-Object -Process { $_ -replace '\s{2,}', ',' }
		$quserObject = $quserRegex | ConvertFrom-Csv
		$userSession = $quserObject | Where-Object -FilterScript { $_.STATE -eq 'active' }
		$sessionID = $userSession.ID
	}
	
	if (!$sessionID)
	{
		$msgBox0 = [System.Windows.Forms.MessageBox]::Show('No active session found. Use RDP to login with your profile.')
	}
	else
	{
		$msgBoxInput = [System.Windows.Forms.MessageBox]::Show('This will request permission from the active user to view and control their computer. Proceed?', 'Remote Confirmation', 'OKCancel', 'Warning')
	}
	
	switch ($msgBoxInput)
	{
		
		'OK' {
			
			## Do something 
			mstsc /v:$global:Cname /shadow:$sessionID /control
			
		}
		
		
		'Cancel' {
			
			## Do something
			
		}
		
	}
}

