$buttonReset_Click = {
	# ================================
	# User / Device Selection
	# ================================
	
	$SelectedItem = [string]$combobox1.SelectedItem
	
	# If the ComboBox selection is a user
	if ($SelectedItem -match '@')
	{
		$UserEmail = $SelectedItem
		
		# Check that the user exists
		$UserUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
		[Uri]::EscapeDataString($UserEmail)
		
		try
		{
			$User = Invoke-RestMethod `
									  -Uri $UserUri `
									  -Method Get `
									  -Headers @{
				Authorization  = "Bearer $global:AccessToken"
			} `
									  -ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nUser does not exist: $UserEmail")
			return
		}
		
		# ================================
		# User Recovery Options Dialog
		# ================================
		
		$RecoveryForm = New-Object System.Windows.Forms.Form
		$RecoveryForm.Text = "User Recovery"
		$RecoveryForm.Size = New-Object System.Drawing.Size(520, 180)
		$RecoveryForm.StartPosition = "CenterScreen"
		$RecoveryForm.FormBorderStyle = "FixedDialog"
		$RecoveryForm.MaximizeBox = $false
		$RecoveryForm.MinimizeBox = $false
		
		$RecoveryLabel = New-Object System.Windows.Forms.Label
		$RecoveryLabel.Text = "Select an action for:`r`n$UserEmail"
		$RecoveryLabel.Location = New-Object System.Drawing.Point(20, 20)
		$RecoveryLabel.AutoSize = $true
		
		$RecoveryCodesButton = New-Object System.Windows.Forms.Button
		$RecoveryCodesButton.Text = "Recovery Codes"
		$RecoveryCodesButton.Location = New-Object System.Drawing.Point(20, 80)
		$RecoveryCodesButton.Size = New-Object System.Drawing.Size(145, 35)
		$RecoveryCodesButton.DialogResult = [System.Windows.Forms.DialogResult]::Yes
		
		$ResetPasswordButton = New-Object System.Windows.Forms.Button
		$ResetPasswordButton.Text = "Reset Password"
		$ResetPasswordButton.Location = New-Object System.Drawing.Point(175, 80)
		$ResetPasswordButton.Size = New-Object System.Drawing.Size(145, 35)
		$ResetPasswordButton.DialogResult = [System.Windows.Forms.DialogResult]::Retry
		
		$CancelRecoveryButton = New-Object System.Windows.Forms.Button
		$CancelRecoveryButton.Text = "Cancel"
		$CancelRecoveryButton.Location = New-Object System.Drawing.Point(330, 80)
		$CancelRecoveryButton.Size = New-Object System.Drawing.Size(145, 35)
		$CancelRecoveryButton.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
		
		$RecoveryForm.Controls.Add($RecoveryLabel)
		$RecoveryForm.Controls.Add($RecoveryCodesButton)
		$RecoveryForm.Controls.Add($ResetPasswordButton)
		$RecoveryForm.Controls.Add($CancelRecoveryButton)
		
		$RecoveryForm.CancelButton = $CancelRecoveryButton
		
		$RecoveryChoice = $RecoveryForm.ShowDialog()
		
		# ================================
		# Recovery Codes
		# ================================
		
		if ($RecoveryChoice -eq [System.Windows.Forms.DialogResult]::Yes)
		{
			$CodesBaseUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
			[Uri]::EscapeDataString($UserEmail) +
			'/verificationCodes'
			
			# --------------------------------
			# Generate new recovery codes
			# --------------------------------
			
			$GenerateUri = $CodesBaseUri + '/generate'
			
			try
			{
				Invoke-RestMethod `
								  -Uri $GenerateUri `
								  -Method Post `
								  -Headers @{
					Authorization  = "Bearer $global:AccessToken"
				} `
								  -ErrorAction Stop
			}
			catch
			{
				$outbox.AppendText("`r`nFailed to generate recovery codes.")
				$outbox.AppendText("`r`n$($_.Exception.Message)")
				return
			}
			
			# --------------------------------
			# Retrieve the newly generated codes
			# --------------------------------
			
			try
			{
				$CodeResponse = Invoke-RestMethod `
												  -Uri $CodesBaseUri `
												  -Method Get `
												  -Headers @{
					Authorization  = "Bearer $global:AccessToken"
				} `
												  -ErrorAction Stop
			}
			catch
			{
				$outbox.AppendText("`r`nCodes were generated, but could not be retrieved.")
				$outbox.AppendText("`r`n$($_.Exception.Message)")
				return
			}
			
			$Codes = @()
			
			if ($CodeResponse.PSObject.Properties['items'])
			{
				$Codes = @($CodeResponse.items)
			}
			
			$outbox.AppendText("`r`n")
			$outbox.AppendText("Recovery codes for $UserEmail")
			$outbox.AppendText("`r`n--------------------------------")
			
			if ($Codes.Count -eq 0)
			{
				$outbox.AppendText("`r`nNo recovery codes were returned.")
			}
			else
			{
				foreach ($Code in $Codes)
				{
					if ($Code.verificationCode)
					{
						$outbox.AppendText("`r`n$($Code.verificationCode)")
					}
				}
			}
			
			$outbox.AppendText("`r`n--------------------------------")
			
			return
		}
		
		# ================================
		# Reset Password
		# ================================
		
		if ($RecoveryChoice -eq [System.Windows.Forms.DialogResult]::Retry)
		{
			$PasswordForm = New-Object System.Windows.Forms.Form
			$PasswordForm.Text = "Reset Password"
			$PasswordForm.Size = New-Object System.Drawing.Size(430, 190)
			$PasswordForm.StartPosition = "CenterScreen"
			$PasswordForm.FormBorderStyle = "FixedDialog"
			$PasswordForm.MaximizeBox = $false
			$PasswordForm.MinimizeBox = $false
			
			$PasswordLabel = New-Object System.Windows.Forms.Label
			$PasswordLabel.Text = "New password:"
			$PasswordLabel.Location = New-Object System.Drawing.Point(20, 30)
			$PasswordLabel.AutoSize = $true
			
			$PasswordBox = New-Object System.Windows.Forms.TextBox
			$PasswordBox.Location = New-Object System.Drawing.Point(120, 27)
			$PasswordBox.Size = New-Object System.Drawing.Size(270, 25)
			
			# Password is intentionally NOT masked
			
			$PasswordOKButton = New-Object System.Windows.Forms.Button
			$PasswordOKButton.Text = "OK"
			$PasswordOKButton.Location = New-Object System.Drawing.Point(225, 80)
			$PasswordOKButton.Size = New-Object System.Drawing.Size(75, 30)
			$PasswordOKButton.DialogResult = [System.Windows.Forms.DialogResult]::OK
			
			$PasswordCancelButton = New-Object System.Windows.Forms.Button
			$PasswordCancelButton.Text = "Cancel"
			$PasswordCancelButton.Location = New-Object System.Drawing.Point(315, 80)
			$PasswordCancelButton.Size = New-Object System.Drawing.Size(75, 30)
			$PasswordCancelButton.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
			
			$PasswordForm.Controls.Add($PasswordLabel)
			$PasswordForm.Controls.Add($PasswordBox)
			$PasswordForm.Controls.Add($PasswordOKButton)
			$PasswordForm.Controls.Add($PasswordCancelButton)
			
			$PasswordForm.AcceptButton = $PasswordOKButton
			$PasswordForm.CancelButton = $PasswordCancelButton
			
			$PasswordResult = $PasswordForm.ShowDialog()
			
			if ($PasswordResult -eq [System.Windows.Forms.DialogResult]::OK)
			{
				$NewPassword = $PasswordBox.Text
				
				if ([string]::IsNullOrWhiteSpace($NewPassword))
				{
					$outbox.AppendText("`r`nPassword reset cancelled: no password entered.")
					return
				}
				
				if ($NewPassword.Length -lt 8)
				{
					$outbox.AppendText("`r`nPassword reset failed: password must be at least 8 characters.")
					return
				}
				
				if ($NewPassword.Length -gt 100)
				{
					$outbox.AppendText("`r`nPassword reset failed: password cannot exceed 100 characters.")
					return
				}
				
				$PasswordUri = 'https://admin.googleapis.com/admin/directory/v1/users/' +
				[Uri]::EscapeDataString($UserEmail)
				
				$PasswordBody = @{
					password  = $NewPassword
				} | ConvertTo-Json -Compress
				
				try
				{
					Invoke-RestMethod `
									  -Uri $PasswordUri `
									  -Method Put `
									  -Headers @{
						Authorization  = "Bearer $global:AccessToken"
						'Content-Type' = 'application/json'
					} `
									  -Body $PasswordBody `
									  -ErrorAction Stop
					
					$outbox.AppendText("`r`nPassword reset successfully for $UserEmail.")
				}
				catch
				{
					$outbox.AppendText("`r`nPassword reset failed.")
					$outbox.AppendText("`r`n$($_.Exception.Message)")
				}
			}
			
			return
		}
		
		# Cancel
		return
	}
	
	# ================================
	# Existing serial/device code
	# ================================
	# ================================
	# Chromebook Wipe / PowerWash
	# ================================
	
	if (-not $global:AccessToken)
	{
		return
	}
	
	$Device = $global:Devices |
	Where-Object { $_.serialNumber -eq $global:Cname } |
	Select-Object -First 1
	
	if (-not $Device)
	{
		$Device = $global:Devices |
		Where-Object { $_.serialNumber -eq $combobox1.Text } |
		Select-Object -First 1
	}
	
	if (-not $Device)
	{
		$outbox.AppendText("`r`nDevice not found.")
		return
	}
	
	$Headers = @{
		Authorization  = "Bearer $global:AccessToken"
	}
	
	# --------------------------------
	# Create action menu
	# --------------------------------
	
	$ActionForm = New-Object System.Windows.Forms.Form
	$ActionForm.Text = "Device Reset"
	$ActionForm.Size = New-Object System.Drawing.Size(390, 160)
	$ActionForm.StartPosition = "CenterScreen"
	$ActionForm.FormBorderStyle = "FixedDialog"
	$ActionForm.MaximizeBox = $false
	$ActionForm.MinimizeBox = $false
	
	$PowerWashButton = New-Object System.Windows.Forms.Button
	$PowerWashButton.Location = New-Object System.Drawing.Point(15, 20)
	$PowerWashButton.Size = New-Object System.Drawing.Size(115, 35)
	$PowerWashButton.Text = "PowerWash"
	
	$WipeUsersButton = New-Object System.Windows.Forms.Button
	$WipeUsersButton.Location = New-Object System.Drawing.Point(140, 20)
	$WipeUsersButton.Size = New-Object System.Drawing.Size(115, 35)
	$WipeUsersButton.Text = "Wipe Users"
	
	$CancelButton = New-Object System.Windows.Forms.Button
	$CancelButton.Location = New-Object System.Drawing.Point(265, 20)
	$CancelButton.Size = New-Object System.Drawing.Size(95, 35)
	$CancelButton.Text = "Cancel"
	
	$PowerWashButton.Add_Click({
			$ActionForm.Tag = "PowerWash"
			$ActionForm.Close()
		})
	
	$WipeUsersButton.Add_Click({
			$ActionForm.Tag = "Wipe Users"
			$ActionForm.Close()
		})
	
	$CancelButton.Add_Click({
			$ActionForm.Tag = "Cancel"
			$ActionForm.Close()
		})
	
	$ActionForm.Controls.Add($PowerWashButton)
	$ActionForm.Controls.Add($WipeUsersButton)
	$ActionForm.Controls.Add($CancelButton)
	
	[void]$ActionForm.ShowDialog()
	
	$Action = $ActionForm.Tag
	$ActionForm.Dispose()
	
	if ($Action -eq "Cancel" -or -not $Action)
	{
		return
	}
	
	# --------------------------------
	# Determine command
	# --------------------------------
	
	if ($Action -eq "PowerWash")
	{
		$CommandType = "REMOTE_POWERWASH"
	}
	elseif ($Action -eq "Wipe Users")
	{
		$CommandType = "WIPE_USERS"
	}
	else
	{
		return
	}
	
	# --------------------------------
	# Issue command
	# --------------------------------
	
	$Body = @{
		commandType  = $CommandType
	} | ConvertTo-Json -Compress
	
	$Uri = "https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos/$($Device.deviceId):issueCommand"
	
	try
	{
		$Result = Invoke-RestMethod `
									-Uri $Uri `
									-Method Post `
									-Headers $Headers `
									-ContentType "application/json" `
									-Body $Body `
									-ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`n$Action request failed.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	$outbox.AppendText("`r`n$Action command issued.")
	$outbox.AppendText("`r`nCommand ID: $($Result.commandId)")
}

$buttonProfiles_Click = {
	# ================================
	# Start Chrome Remote Session
	# ================================
	
	if (-not $global:AccessToken)
	{
		return
	}
	
	$Device = $null
	
	# --------------------------------
	# 1. Try search field first
	# --------------------------------
	
	$Device = $global:Devices |
	Where-Object { $_.serialNumber -eq $global:Cname } |
	Select-Object -First 1
	
	# --------------------------------
	# 2. If not found, try ComboBox
	# --------------------------------
	
	if (-not $Device)
	{
		$SelectedItem = [string]$combobox1.Text
		
		$Device = $global:Devices |
		Where-Object { $_.serialNumber -eq $SelectedItem } |
		Select-Object -First 1
	}
	
	# --------------------------------
	# 3. Stop if device not found
	# --------------------------------
	
	if (-not $Device)
	{
		$outbox.AppendText("`r`nDevice not found.")
		return
	}
	
	$Headers = @{
		Authorization	   = "Bearer $global:AccessToken"
	}
	
	$BaseUri = "https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos/$($Device.deviceId)"
	
	# --------------------------------
	# 4. Ask device what CRD modes
	#    are currently available
	# --------------------------------
	
	$AvailabilityBody = @{
		commandType  = 'FETCH_CRD_AVAILABILITY_INFO'
	} | ConvertTo-Json -Compress
	
	try
	{
		$AvailabilityCommand = Invoke-RestMethod `
												 -Uri "$BaseUri`:issueCommand" `
												 -Method Post `
												 -Headers $Headers `
												 -ContentType 'application/json' `
												 -Body $AvailabilityBody `
												 -ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`nFailed to request CRD availability.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	# --------------------------------
	# 5. Poll availability command
	# --------------------------------
	
	$AvailabilityResult = $null
	
	for ($i = 1; $i -le 20; $i++)
	{
		Start-Sleep -Seconds 1
		
		try
		{
			$AvailabilityResult = Invoke-RestMethod `
													-Uri "$BaseUri/commands/$($AvailabilityCommand.commandId)" `
													-Method Get `
													-Headers $Headers `
													-ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nFailed to retrieve CRD availability result.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		if ($AvailabilityResult.commandResult.result -eq 'SUCCESS')
		{
			break
		}
		
		if ($AvailabilityResult.commandResult.result -eq 'FAILURE')
		{
			$outbox.AppendText("`r`nCRD availability check failed.")
			$outbox.AppendText("`r`n$($AvailabilityResult.commandResult.errorMessage)")
			return
		}
	}
	
	if (-not $AvailabilityResult.commandResult.commandResultPayload)
	{
		$outbox.AppendText("`r`nNo CRD availability information was returned.")
		return
	}
	
	try
	{
		$Availability = $AvailabilityResult.commandResult.commandResultPayload |
		ConvertFrom-Json
	}
	catch
	{
		$outbox.AppendText("`r`nUnable to parse CRD availability response.")
		return
	}
	
	$outbox.AppendText("`r`nShared CRD: $($Availability.remoteSupportAvailability)")
	$outbox.AppendText("`r`nPrivate CRD: $($Availability.remoteAccessAvailability)")
	
	# --------------------------------
	# 6. Choose session type
	# --------------------------------
	
	$SessionType = $null
	
	if ($Availability.remoteSupportAvailability -eq 'AVAILABLE')
	{
		$SessionType = 'shared'
	}
	elseif ($Availability.remoteAccessAvailability -eq 'AVAILABLE')
	{
		$SessionType = 'private'
	}
	
	if (-not $SessionType)
	{
		$outbox.AppendText("`r`nNo remote session type is currently available.")
		return
	}
	
	$outbox.AppendText("`r`nStarting $SessionType remote session...")
	
	# --------------------------------
	# 7. Start CRD session
	# --------------------------------
	
	$SessionPayload = @{
		crdSessionType	      = $SessionType
		ackedUserPresence	  = $true
	} | ConvertTo-Json -Compress
	
	$SessionBody = @{
		commandType  = 'DEVICE_START_CRD_SESSION'
		payload	     = $SessionPayload
	} | ConvertTo-Json -Compress
	
	try
	{
		$SessionCommand = Invoke-RestMethod `
											-Uri "$BaseUri`:issueCommand" `
											-Method Post `
											-Headers $Headers `
											-ContentType 'application/json' `
											-Body $SessionBody `
											-ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`nFailed to start $SessionType CRD session.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	$outbox.AppendText("`r`nCommand ID: $($SessionCommand.commandId)")
	
	# --------------------------------
	# 8. Poll for CRD URL
	# --------------------------------
	
	$SessionResult = $null
	
	for ($i = 1; $i -le 20; $i++)
	{
		Start-Sleep -Seconds 1
		
		try
		{
			$SessionResult = Invoke-RestMethod `
											   -Uri "$BaseUri/commands/$($SessionCommand.commandId)" `
											   -Method Get `
											   -Headers $Headers `
											   -ErrorAction Stop
		}
		catch
		{
			$outbox.AppendText("`r`nFailed to retrieve remote session result.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		if ($SessionResult.commandResult.result -eq 'SUCCESS')
		{
			break
		}
		
		if ($SessionResult.commandResult.result -eq 'FAILURE')
		{
			$outbox.AppendText("`r`nRemote session failed.")
			$outbox.AppendText("`r`n$($SessionResult.commandResult.errorMessage)")
			return
		}
	}
	
	# --------------------------------
	# 9. Get CRD URL
	# --------------------------------
	
	if (-not $SessionResult.commandResult.commandResultPayload)
	{
		$outbox.AppendText("`r`nRemote session did not return a CRD URL.")
		return
	}
	
	try
	{
		$SessionInfo = $SessionResult.commandResult.commandResultPayload |
		ConvertFrom-Json
	}
	catch
	{
		$outbox.AppendText("`r`nUnable to parse remote session response.")
		return
	}
	
	if (-not $SessionInfo.url)
	{
		$outbox.AppendText("`r`nNo remote session URL was returned.")
		return
	}
	
	#$outbox.AppendText("`r`nRemote session ready.")
	#$outbox.AppendText("`r`nOpening Chrome Remote Desktop...")
	
	#Start-Process $SessionInfo.url
	# --------------------------------
	# 9. Open CRD in matching Chrome
	#    profile or Incognito
	# --------------------------------
	
	
	$outbox.AppendText("`r`nRemote session ready.")
	$outbox.AppendText("`r`nOAuth account: $global:OAuthEmail")
	
	# --------------------------------
	# Find Chrome
	# --------------------------------
	
	$ChromePaths = @(
		"${env:ProgramFiles}\Google\Chrome\Application\chrome.exe",
		"${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
		"$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe"
	)
	
	$ChromePath = $ChromePaths |
	Where-Object { Test-Path $_ } |
	Select-Object -First 1
	
	if (-not $ChromePath)
	{
		$outbox.AppendText("`r`nChrome was not found.")
		return
	}
	
	# --------------------------------
	# Look for exact email match
	# --------------------------------
	
	$LocalState = "$env:LOCALAPPDATA\Google\Chrome\User Data\Local State"
	$ProfileDirectory = $null
	
	if (Test-Path $LocalState)
	{
		try
		{
			$ChromeState = Get-Content $LocalState -Raw |
			ConvertFrom-Json
			
			$Profile = $ChromeState.profile.info_cache.PSObject.Properties |
			Where-Object {
				$_.Value.user_name -eq $global:OAuthEmail -or
				$_.Value.gaia_name -eq $global:OAuthEmail
			} |
			Select-Object -First 1
			
			if ($Profile)
			{
				$ProfileDirectory = $Profile.Name
				
				$outbox.AppendText(
					"`r`nMatching Chrome profile found: $ProfileDirectory"
				)
			}
			else
			{
				$outbox.AppendText(
					"`r`nNo Chrome profile found for $global:OAuthEmail"
				)
			}
		}
		catch
		{
			$outbox.AppendText(
				"`r`nUnable to read Chrome profile information."
			)
		}
	}
	else
	{
		$outbox.AppendText(
			"`r`nChrome Local State file not found."
		)
	}
	
	# --------------------------------
	# Launch CRD
	# --------------------------------
	
	if ($ProfileDirectory)
	{
		$outbox.AppendText(
			"`r`nOpening Chrome using the matching profile..."
		)
		
		Start-Process $ChromePath -ArgumentList @(
			"--profile-directory=`"$ProfileDirectory`"",
			"--new-window",
			$SessionInfo.url
		)
	}
	else
	{
		$outbox.AppendText(
			"`r`nOpening Chrome Remote Desktop in Incognito..."
		)
		
		Start-Process $ChromePath -ArgumentList @(
			"--incognito",
			"--new-window",
			$SessionInfo.url
		)
	}
}

