$ExploreFiles_Click = {
	$global:Cname = $textbox1.Text
	# ================================
	# Google OAuth 2.0 Desktop Test
	# ================================
	
	$ClientId = $global:clientid
	$ClientSecret = $global:secret
	
	$Domain = $global:domain
	#$SearchTerm = 'NXKEAAA0013120D0A47600' # TEST SEARCH TERM
	
	$SearchTerm = $global:Cname
	$outbox.AppendText("`r`nLooking up $global:Cname")
	
	$global:Devices = $null
	
	if ($global:AccessToken)
	{
		try
		{
			$TokenInfo = Invoke-RestMethod `
										   -Uri "https://oauth2.googleapis.com/tokeninfo?access_token=$([Uri]::EscapeDataString($global:AccessToken))" `
										   -Method Get `
										   -ErrorAction Stop
			
			$Headers = @{
				Authorization  = "Bearer $global:AccessToken"
			}
		}
		catch
		{
			# Token is no longer valid
			$global:AccessToken = $null
		}
	}
	
	if (-not $global:AccessToken)
	{
		
		
		# Local callback
		$Port = 43817
		$RedirectUri = "http://127.0.0.1:$Port/"
		
		# ================================
		# PKCE - Code Verifier
		# ================================
		
		$RandomBytes = New-Object byte[] 32
		[System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($RandomBytes)
		
		$CodeVerifier = [Convert]::ToBase64String($RandomBytes).
		TrimEnd('=').Replace('+', '-').Replace('/', '_')
		
		# ================================
		# PKCE - Code Challenge
		# ================================
		
		$Sha256 = [System.Security.Cryptography.SHA256]::Create()
		$ChallengeBytes = $Sha256.ComputeHash(
			[System.Text.Encoding]::ASCII.GetBytes($CodeVerifier)
		)
		
		$CodeChallenge = [Convert]::ToBase64String($ChallengeBytes).
		TrimEnd('=').Replace('+', '-').Replace('/', '_')
		
		# ================================
		# OAuth State
		# ================================
		
		$StateBytes = New-Object byte[] 32
		[System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($StateBytes)
		
		$State = [Convert]::ToBase64String($StateBytes).
		TrimEnd('=').Replace('+', '-').Replace('/', '_')
		
		# ================================
		# Start HTTP Listener
		# ================================
		
		$Listener = New-Object System.Net.HttpListener
		$Listener.Prefixes.Add($RedirectUri)
		
		try
		{
			$Listener.Start()
		}
		catch
		{
			Write-Host "Unable to start local OAuth listener."
			Write-Host $_.Exception.Message
			return
		}
		
		# ================================
		# Build Authorization URL
		# ================================
		
		$HostedDomain = $Domain.TrimStart('@')
		$AuthParams = @{
			client_id				     = $ClientId
			redirect_uri				 = $RedirectUri
			response_type			     = 'code'
			scope					     = $Scope
			access_type				     = 'offline'
			prompt					     = ''
			state					     = $State
			code_challenge			     = $CodeChallenge
			code_challenge_method	     = 'S256'
			hd						     = $([Uri]::EscapeDataString($HostedDomain))
		}
		
		$AuthParams.GetEnumerator() | ForEach-Object {
			Write-Host "$($_.Key) = [$($_.Value)]"
		}
		
		$QueryParts = foreach ($Item in $AuthParams.GetEnumerator())
		{
			
			$EncodedKey = [Uri]::EscapeDataString([string]$Item.Key)
			$EncodedValue = [Uri]::EscapeDataString([string]$Item.Value)
			
			"$EncodedKey=$EncodedValue"
		}
		
		$AuthUrl = "https://accounts.google.com/o/oauth2/v2/auth?" +
		($QueryParts -join '&')
		
		# ================================
		# Open Browser
		# ================================
		
		Write-Host "Opening browser..."
		Start-Process $AuthUrl
		
		Write-Host "Waiting for Google authorization..."
		
		# ================================
		# Wait for Browser Callback
		# ================================
		
		try
		{
			$Context = $Listener.GetContext()
		}
		catch
		{
			$Listener.Stop()
			Write-Host "OAuth listener failed."
			Write-Host $_.Exception.Message
			return
		}
		
		# ================================
		# Send Browser Response
		# ================================
		
		$Html = @"
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Authorization Complete</title>
</head>
<body>
    Authorization successful. Workspace tool is ready for use.<br><br>
    You may close this tab or wait ten seconds to be taken to Google Workspace...

    <script>
        setTimeout(function () {
            window.location.href = "https://admin.google.com/";
        }, 10000);
    </script>
</body>
</html>
"@
		
		$Buffer = [System.Text.Encoding]::UTF8.GetBytes($Html)
		
		$Context.Response.ContentType = 'text/html'
		$Context.Response.ContentLength64 = $Buffer.Length
		
		$Context.Response.OutputStream.Write(
			$Buffer,
			0,
			$Buffer.Length
		)
		
		$Context.Response.OutputStream.Close()
		
		$Listener.Stop()
		
		# ================================
		# Read OAuth Callback
		# ================================
		
		$Code = $Context.Request.QueryString['code']
		$ReturnedState = $Context.Request.QueryString['state']
		$OAuthError = $Context.Request.QueryString['error']
		$OAuthErrorDescription = $Context.Request.QueryString['error_description']
		
		Write-Host ""
		Write-Host "Google callback received:"
		Write-Host "  Code:               $(if ($Code) { 'YES' }
			else { 'NO' })"
		Write-Host "  State:              $(if ($ReturnedState) { 'YES' }
			else { 'NO' })"
		Write-Host "  OAuth Error:        [$OAuthError]"
		Write-Host "  Error Description:  [$OAuthErrorDescription]"
		Write-Host ""
		
		# ================================
		# Validate Callback
		# ================================
		
		if ($OAuthError)
		{
			
			Write-Host "Google returned an OAuth error:"
			Write-Host $OAuthError
			Write-Host $OAuthErrorDescription
			
			return
		}
		
		if (-not $Code)
		{
			
			Write-Host "No authorization code was returned."
			
			return
		}
		
		if ($ReturnedState -ne $State)
		{
			
			Write-Host "OAuth state validation failed."
			
			return
		}
		
		
		# ================================
		# Exchange Code for Token
		# ================================
		
		$TokenBody = @{
			client_id	     = $ClientId
			client_secret    = $ClientSecret
			code			 = $Code
			code_verifier    = $CodeVerifier
			grant_type	     = 'authorization_code'
			redirect_uri	 = $RedirectUri
		}
		
		try
		{
			
			$TokenResponse = Invoke-RestMethod `
											   -Uri 'https://oauth2.googleapis.com/token' `
											   -Method Post `
											   -ContentType 'application/x-www-form-urlencoded' `
											   -Body $TokenBody `
											   -ErrorAction Stop
			
		}
		catch
		{
			
			Write-Host ""
			Write-Host "Google token request failed."
			Write-Host "HTTP error:"
			Write-Host $_.Exception.Message
			Write-Host ""
			
			if ($_.Exception.Response)
			{
				
				try
				{
					
					$Reader = New-Object System.IO.StreamReader(
						$_.Exception.Response.GetResponseStream()
					)
					
					$ResponseBody = $Reader.ReadToEnd()
					
					$Reader.Close()
					
					Write-Host "Google response:"
					Write-Host $ResponseBody
					
				}
				catch
				{
					
					Write-Host "Unable to read Google's error response."
				}
			}
			
			return
		}
		
		# ================================
		# Display Result
		# ================================
		
		if (-not $TokenResponse.access_token)
		{
			
			Write-Host ""
			Write-Host "Google did not return an access token."
			Write-Host ($TokenResponse | Out-String)
			
			return
		}
		
		Write-Host ""
		Write-Host "Authentication successful."
		Write-Host "Access token received: $($TokenResponse.access_token.Length) characters"
		
		if ($TokenResponse.refresh_token)
		{
			Write-Host "Refresh token received."
		}
		else
		{
			Write-Host "No refresh token was returned."
		}
		
		#Write-Host ""
		#Write-Host "OAuth test completed."
		$global:AccessToken = $TokenResponse.access_token
		$global:RefreshToken = $TokenResponse.refresh_token
		
		<#
		Write-Host ""
		Write-Host "Scopes actually granted:"
		Write-Host $TokenResponse.scope
		Write-Host ""#>
		
		# ================================
		# Get OAuth account email
		# ================================
		$UserInfo = Invoke-RestMethod `
									  -Uri "https://openidconnect.googleapis.com/v1/userinfo" `
									  -Headers @{
			Authorization   = "Bearer $global:AccessToken"
		} `
									  -ErrorAction Stop
		
		$global:OAuthEmail = $UserInfo.email
		# ================================
		# Store Access Token
		# ================================
		
		$global:AccessToken = $TokenResponse.access_token
		
		
	} # End of authentication else block
	# ================================
	# Chromebook Device Search
	# ================================
	
	$Headers = @{
		Authorization   = "Bearer $global:AccessToken"
	}
	
	$Devices = @()
	$SearchResultType = $null
	$SearchEmail = $null
	
	# Clear previous ComboBox contents
	$combobox1.Items.Clear()
	
	# --------------------------------
	# 1. Search serial number first
	# --------------------------------
	
	if ($SearchTerm.Length -ge 3)
	{
		$Query = "id:$SearchTerm"
		
		$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
		'?projection=FULL' +
		'&maxResults=21' +
		'&query=' + [Uri]::EscapeDataString($Query)
		
		try
		{
			$Response = Invoke-RestMethod `
										  -Uri $Uri `
										  -Method Get `
										  -Headers $Headers `
										  -ErrorAction Stop
			
			if ($Response.PSObject.Properties['chromeosdevices'])
			{
				$Devices = @($Response.chromeosdevices)
			}
		}
		catch
		{
			$outbox.AppendText("`r`nSerial search failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		if ($Devices.Count -gt 0)
		{
			$SearchResultType = 'Device'
		}
	}
	
	# --------------------------------
	# 2. If no serial results,
	#    search recent user
	# --------------------------------
	<#
	if ($Devices.Count -eq 0)
	{
		$SearchEmail = $SearchTerm
		
		if ($SearchEmail -notmatch '@')
		{
			$SearchEmail = $SearchEmail + $Domain
		}
		
		$Query = "recent_user:$SearchEmail"
		
		$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
		'?projection=FULL' +
		'&maxResults=11' +
		'&query=' + [Uri]::EscapeDataString($Query)
		
		try
		{
			$Response = Invoke-RestMethod `
										  -Uri $Uri `
										  -Method Get `
										  -Headers $Headers `
										  -ErrorAction Stop
			
			if ($Response.PSObject.Properties['chromeosdevices'])
			{
				$Devices = @($Response.chromeosdevices)
			}
		}
		catch
		{
			$outbox.AppendText("`r`nRecent-user search failed.")
			$outbox.AppendText("`r`n$($_.Exception.Message)")
			return
		}
		
		if ($Devices.Count -gt 0)
		{
			$SearchResultType = 'User'
		}
	}
	#>
	# --------------------------------
	# 2. If no serial results,
	#    search recent user
	# --------------------------------
	$MatchingUsers = @()
	if ($Devices.Count -eq 0)
	{
		$SearchEmail = $SearchTerm
		
		# --------------------------------
		# If only a username was entered,
		# find matching Workspace users first
		# --------------------------------
		
		if ($SearchEmail -notmatch '@')
		{
			#$UserQuery = "email:$SearchEmail*"
			$SearchParts = $SearchEmail -split '\s+', 2
			
			if ($SearchParts.Count -eq 2)
			{
				$UserQuery = "givenName:$($SearchParts[0])* familyName:$($SearchParts[1])*"
			}
			else
			{
				$UserQuery = "email:$SearchEmail*"
			}
			
			$UserUri = 'https://admin.googleapis.com/admin/directory/v1/users' +
			'?customer=my_customer' +
			'&maxResults=20' +
			'&query=' + [Uri]::EscapeDataString($UserQuery)
			
			try
			{
				$UserResponse = Invoke-RestMethod `
												  -Uri $UserUri `
												  -Method Get `
												  -Headers $Headers `
												  -ErrorAction Stop
				
				$MatchingUsers = @()
				
				if ($UserResponse.PSObject.Properties['users'])
				{
					$MatchingUsers = @($UserResponse.users)
				}
			}
			catch
			{
				$outbox.AppendText("`r`nUsername search failed.")
				$outbox.AppendText("`r`n$($_.Exception.Message)")
				return
			}
			
			# --------------------------------
			# Search ChromeOS for each matching
			# full email address
			# --------------------------------
			
			$Devices = @()
			
			foreach ($User in $MatchingUsers)
			{
				if ($User.primaryEmail)
				{
					$Query = "recent_user:$($User.primaryEmail)"
					
					$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
					'?projection=FULL' +
					'&maxResults=21' +
					'&query=' + [Uri]::EscapeDataString($Query)
					
					try
					{
						$Response = Invoke-RestMethod `
													  -Uri $Uri `
													  -Method Get `
													  -Headers $Headers `
													  -ErrorAction Stop
						
						if ($Response.PSObject.Properties['chromeosdevices'])
						{
							$Devices += @($Response.chromeosdevices)
						}
					}
					catch
					{
						# Continue with other matching users
					}
				}
			}
		}
		else
		{
			# --------------------------------
			# Full email was entered
			# --------------------------------
			
			$Query = "recent_user:$SearchEmail"
			$SearchEmail = $SearchTerm
			$Uri = 'https://admin.googleapis.com/admin/directory/v1/customer/my_customer/devices/chromeos' +
			'?projection=FULL' +
			'&maxResults=21' +
			'&query=' + [Uri]::EscapeDataString($Query)
			
			try
			{
				$Response = Invoke-RestMethod `
											  -Uri $Uri `
											  -Method Get `
											  -Headers $Headers `
											  -ErrorAction Stop
				
				if ($Response.PSObject.Properties['chromeosdevices'])
				{
					$Devices = @($Response.chromeosdevices)
				}
			}
			catch
			{
				$outbox.AppendText("`r`nRecent-user search failed.")
				$outbox.AppendText("`r`n$($_.Exception.Message)")
				return
			}
		}
		
		if ($MatchingUsers.Count -gt 0)
		{
			$SearchResultType = 'User'
		}
	}
	# --------------------------------
	# 3. Check results
	# --------------------------------
	
	if ($Devices.Count -eq 0)
	{
		if ($MatchingUsers.Count -gt 0)
		{
			$outbox.AppendText("`r`nNo matching devices found for the matching user(s).")
		}
		else
		{
			$outbox.AppendText("`r`nNo matching devices or users found.")
			return
		}
	}
	
	if ($Devices.Count -gt 20)
	{
		$outbox.AppendText("`r`nSearch needs to be more specific.")
		$outbox.AppendText("`r`nMore than 20 results.")
		#return
	}
	$global:Devices = $Devices
	# --------------------------------
	# 4. Populate ComboBox
	# --------------------------------
	
	<#old
	if ($SearchResultType -eq 'Device')
	{
		# Serial/device search:
		# ComboBox = recent users
		
		foreach ($Device in @($Devices))
		{
			foreach ($RecentUser in @($Device.recentUsers))
			{
				if ($RecentUser.email)
				{
					Update-ComboBox `
									-ComboBox $combobox1 `
									-Items $RecentUser.email `
									-Append
				}
			}
		}
	}
	
	if ($SearchResultType -eq 'Device')
	{
		# One device = recent users
		if ($Devices.Count -eq 1)
		{
			foreach ($Device in $Devices)
			{
				foreach ($RecentUser in @($Device.recentUsers))
				{
					if ($RecentUser.email)
					{
						Update-ComboBox `
										-ComboBox $combobox1 `
										-Items $RecentUser.email `
										-Append
					}
				}
			}
		}
		else
		{
			# Multiple devices = device serials
			foreach ($Device in $Devices)
			{
				if ([string]::IsNullOrWhiteSpace($Device.serialNumber))
				{
					$Model = $Device.model -replace '\s*\(.*\)$', ''
					$ComboText = "Unknown - $Model"
				}
				else
				{
					$ComboText = $Device.serialNumber
				}
				
				Update-ComboBox `
								-ComboBox $combobox1 `
								-Items $ComboText `
								-Append
			}
		}
	}
	#>
	if ($SearchResultType -eq 'Device')
	{
		# Device search = device serials
		foreach ($Device in $Devices)
		{
			if ([string]::IsNullOrWhiteSpace($Device.serialNumber))
			{
				$Model = $Device.model -replace '\s*\(.*\)$', ''
				$ComboText = "Unknown - $Model"
			}
			else
			{
				$ComboText = $Device.serialNumber
			}
			
			Update-ComboBox `
							-ComboBox $combobox1 `
							-Items $ComboText `
							-Append
		}
		
		# One device = also add recent users
		if ($Devices.Count -eq 1)
		{
			foreach ($Device in $Devices)
			{
				foreach ($RecentUser in @($Device.recentUsers))
				{
					if ($RecentUser.email)
					{
						Update-ComboBox `
										-ComboBox $combobox1 `
										-Items $RecentUser.email `
										-Append
					}
				}
			}
		}
	}
	elseif ($SearchResultType -eq 'User')
	{
		# User search:
		# ComboBox = users first, then devices
		
		# Matching users
		foreach ($User in @($MatchingUsers))
		{
			if ($User.primaryEmail)
			{
				Update-ComboBox `
								-ComboBox $combobox1 `
								-Items $User.primaryEmail `
								-Append
			}
		}
		
		# Devices
		foreach ($Device in @($Devices))
		{
			$Model = $Device.model -replace '\s*\(.*\)$', ''
			
			if ([string]::IsNullOrWhiteSpace($Device.serialNumber))
			{
				$ComboText = "Unknown - $Model"
			}
			else
			{
				$ComboText = $Device.serialNumber
			}
			
			Update-ComboBox `
							-ComboBox $combobox1 `
							-Items $ComboText `
							-Append
		}
	}
	<#
	elseif ($SearchResultType -eq 'User')
	{
		# User search:
		# ComboBox = devices
		
		foreach ($Device in @($Devices))
		{
			$Model = $Device.model -replace '\s*\(.*\)$', ''
			
			if ([string]::IsNullOrWhiteSpace($Device.serialNumber))
			{
				$ComboText = "Unknown - $Model"
			}
			else
			{
				$ComboText = $Device.serialNumber
			}
			
			Update-ComboBox `
							-ComboBox $combobox1 `
							-Items $ComboText `
							-Append
		}
	}
	#>
	
	if ($combobox1.Items.Count -gt 0)
	{
		$combobox1.SelectedIndex = 0
	}
	
	# --------------------------------
	# 5. Display results
	# --------------------------------
	if ($Devices.Count -gt 0)
	{
		$outbox.AppendText("`r`nDEVICE RESULTS")
		$outbox.AppendText("`r`n==============")
	}
	foreach ($Device in @($Devices))
	{
		$Model = $Device.model -replace '\s*\(.*\)$', ''
		
		$outbox.AppendText("`r`n")
		$outbox.AppendText("`r`nSerial:     $($Device.serialNumber)")
		$outbox.AppendText("`r`nModel:      $Model")
		$outbox.AppendText("`r`nOS Version: $($Device.osVersion)")
		$outbox.AppendText("`r`nLast Sync:  $($Device.lastSync)")
		$outbox.AppendText("`r`nUser:       $($Device.annotatedUser)")
		
		$IPAddresses = @(
			foreach ($Network in @($Device.lastKnownNetwork))
			{
				if ($Network.ipAddress)
				{
					$Network.ipAddress
				}
			}
		)
		
		if ($IPAddresses.Count -gt 0)
		{
			$outbox.AppendText("`r`nIP:")
			
			foreach ($IP in $IPAddresses)
			{
				$outbox.AppendText("`r`n  $IP")
			}
		}
		else
		{
			$outbox.AppendText("`r`nIP: Unknown")
		}
		
		$outbox.AppendText("`r`nRecent Users:")
		
		$RecentUsers = @(
			foreach ($RecentUser in @($Device.recentUsers))
			{
				if ($RecentUser.email)
				{
					$RecentUser.email
				}
			}
		)
		
		if ($RecentUsers.Count -gt 0)
		{
			if ($SearchResultType -eq 'User')
			{
				foreach ($RecentUser in ($RecentUsers | Select-Object -First 3))
				{
					$outbox.AppendText("`r`n  $RecentUser")
				}
			}
			else
			{
				foreach ($RecentUser in $RecentUsers)
				{
					$outbox.AppendText("`r`n  $RecentUser")
				}
			}
		}
		else
		{
			$outbox.AppendText("`r`n  None")
		}
		
		$outbox.AppendText("`r`n------------------------------")
	}
}


