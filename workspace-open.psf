	$labelResultLogClickToOpen.add_Click($outbox_Click)
}

$buttonApps_Click={
	# ============================================================
	# Chrome Apps & Extensions Report Test
	# ============================================================
	
	Add-Type -AssemblyName System.Windows.Forms
	Add-Type -AssemblyName System.Drawing
	
	# --------------------------------
	# Get selected device
	# --------------------------------
	
	if (-not $global:AccessToken)
	{
		$outbox.AppendText("`r`nAccess token not available.")
		return
	}
	
	$Device = $global:Devices |
	Where-Object { $_.serialNumber -eq $global:Cname } |
	Select-Object -First 1
	
	if (-not $Device)
	{
		$Device = $global:Devices |
		Where-Object { $_.serialNumber -eq $combobox1.Text } |
		Select-Object -First 1
	}
	
	if (-not $Device)
	{
		$outbox.AppendText("`r`nDevice not found.")
		return
	}
	
	$Headers = @{
		Authorization   = "Bearer $global:AccessToken"
	}
	
	# --------------------------------
	# Query Apps & Extensions report
	# --------------------------------
	
	$OrgUnitId = $Device.orgUnitId
	
	$Uri = 'https://chromemanagement.googleapis.com/v1/customers/my_customer/reports:countInstalledApps' +
	'?pageSize=100' +
	'&orgUnitId=' + [Uri]::EscapeDataString($OrgUnitId)
	
	try
	{
		$Response = Invoke-RestMethod `
									  -Uri $Uri `
									  -Method Get `
									  -Headers $Headers `
									  -ErrorAction Stop
	}
	catch
	{
		$outbox.AppendText("`r`nApps & Extensions report failed.")
		$outbox.AppendText("`r`n$($_.Exception.Message)")
		return
	}
	
	$Apps = @($Response.installedApps)
	
	$outbox.AppendText("`r`nApps/extensions returned: $($Apps.Count)")
	
	# --------------------------------
	# Display results
	# --------------------------------
	
	$Form = New-Object System.Windows.Forms.Form
	$Form.Text = "Apps & Extensions - $($Device.serialNumber)"
	$Form.Size = New-Object System.Drawing.Size(1500, 800)
	$Form.StartPosition = "CenterScreen"
	
	$Grid = New-Object System.Windows.Forms.DataGridView
	$Grid.Dock = "Fill"
	$Grid.AutoGenerateColumns = $true
	$Grid.ReadOnly = $true
	$Grid.AllowUserToAddRows = $false
	$Grid.AllowUserToDeleteRows = $false
	$Grid.AutoSizeColumnsMode = "DisplayedCells"
	$Grid.SelectionMode = "FullRowSelect"
	$Grid.MultiSelect = $true
	$Grid.ClipboardCopyMode = "EnableAlwaysIncludeHeaderText"
	$Grid.ColumnHeadersHeightSizeMode = "EnableResizing"
	$Grid.ColumnHeadersHeight = 40
	
	$Table = New-Object System.Data.DataTable
	
	[void]$Table.Columns.Add("App Name")
	[void]$Table.Columns.Add("App Type")
	[void]$Table.Columns.Add("App ID")
	[void]$Table.Columns.Add("Install Type")
	[void]$Table.Columns.Add("Source")
	[void]$Table.Columns.Add("Permissions")
	[void]$Table.Columns.Add("Installs")
	
	foreach ($App in $Apps)
	{
		$Row = $Table.NewRow()
		
		$Row["App Name"] = $App.displayName
		$Row["App Type"] = $App.appType
		$Row["App ID"] = $App.appId
		$Row["Install Type"] = $App.appInstallType
		$Row["Source"] = $App.appSource
		$Row["Permissions"] = @($App.permissions).Count
		$Row["Installs"] = $App.browserDeviceCount
		
		[void]$Table.Rows.Add($Row)
	}
	
	$Grid.DataSource = $Table
	
	$Form.Controls.Add($Grid)
	
	[void]$Form.ShowDialog()
	
	$Form.Dispose()
}

$buttonApps_MouseEnter={
		#TODO: Place custom script here
		$richtextbox1.Text = "This function displays installed apps and extensions for a selected device."
	}
	

$buttonApps_MouseLeave={
	$richtextbox1.Text = $global:defaulttext
	
}
